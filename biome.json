{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",

  "files": {
    "includes": ["**", "!dist", "!.astro", "!node_modules"]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "bracketSpacing": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["error"] } },
        "noExplicitAny": "error",
        "useIterableCallbackReturn": {
          "level": "error",
          "options": { "checkForEach": false }
        }
      },

      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useParseIntRadix": "off",
        "useExhaustiveDependencies": "off"
      },

      "style": {
        "useImportType": "error",
        "useConst": "error",
        "noNonNullAssertion": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },

      "complexity": {
        "noUselessFragments": "error"
      },

      "a11y": {
        "useButtonType": "off"
      }
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    },

    "parser": {
      "unsafeParameterDecoratorsEnabled": false
    },

    "experimentalEmbeddedSnippetsEnabled": true
  },

  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },

  "html": {
    "experimentalFullSupportEnabled": false
  },

  "css": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    },
    "parser": {
      "tailwindDirectives": true
    }
  }
}
